{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clean-room module provenance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "revision", "author", "authoredOn", "sources", "notes", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": { "$ref": "#/definitions/text" },
    "revision": { "$ref": "#/definitions/revision" },
    "author": { "$ref": "#/definitions/person" },
    "authoredOn": { "$ref": "#/definitions/date" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "sections", "notes"],
        "properties": {
          "sourceId": { "$ref": "#/definitions/text" },
          "sections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/text" } },
          "notes": { "$ref": "#/definitions/text" }
        }
      }
    },
    "notes": { "$ref": "#/definitions/text" },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewedOn", "reviewedRevision", "evidence", "notes"],
      "properties": {
        "status": { "enum": ["pending", "approved", "changes_requested"] },
        "reviewer": {},
        "reviewedOn": {},
        "reviewedRevision": {},
        "evidence": {},
        "notes": { "$ref": "#/definitions/text" }
      },
      "if": { "properties": { "status": { "const": "pending" } } },
      "then": {
        "properties": {
          "reviewer": { "type": "null" }, "reviewedOn": { "type": "null" },
          "reviewedRevision": { "type": "null" }, "evidence": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "reviewer": { "$ref": "#/definitions/person" }, "reviewedOn": { "$ref": "#/definitions/date" },
          "reviewedRevision": { "$ref": "#/definitions/revision" },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role"],
      "properties": { "id": { "$ref": "#/definitions/text" }, "role": { "$ref": "#/definitions/text" } }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["baseCommit", "files"],
      "properties": {
        "baseCommit": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
        "files": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\s]+$" },
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
